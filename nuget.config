<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    #17: this repository restores with no credentials, like its consumers. DomainServices.Core,
    its only private dependency, is served by the anonymous Azure Blob static feed (Sleet) that
    plusteam restores from (plusteam#2880). Before this, restore read DomainServices.Core from
    GitHub Packages, whose NuGet registry needs a token for every read, so a restore here needed
    a GITHUB_TOKEN_FEED token tied to one developer account.

    Publishing is separate: .github/workflows/publish.yml still pushes WorkItemManagement.Core to
    GitHub Packages and the Sleet feed with its own credentials. Nothing here is used for that.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="plusteam" value="https://plusteamstorage.blob.core.windows.net/nuget/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    DomainServices.* is unclaimed on nuget.org. Mapping it to the one feed allowed to serve it
    keeps nuget.org from answering for it, so a missing package fails the restore instead of
    resolving from the wrong source.
  -->
  <packageSourceMapping>
    <packageSource key="plusteam">
      <package pattern="DomainServices.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
