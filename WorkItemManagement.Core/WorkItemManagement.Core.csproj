<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The documentation on these types is the contract: what each rule refuses and why, and
         which of seven quiet defects a step prevents. Without this it never leaves the repo, and a
         consumer sees bare signatures in IntelliSense. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 is "this public member has no doc comment", which the pre-0.4.0 work-item surface
         trips on throughout. Documenting that surface is its own work; silencing it here keeps the
         warnings that matter visible - a broken cref or a malformed block is a doc that lies, and
         those still fail the build. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>WorkItemManagement.Core</PackageId>
    <Version>0.4.0</Version>
    <Authors>baranhakanozdemir</Authors>
    <Description>Canonical work-item domain model and WBS planning surface: entities, services, repository interfaces, and the readiness rules that decide whether a proposed work breakdown is fit for review. Extracted from PlusTeam.</Description>
    <RepositoryUrl>https://github.com/baranhakanozdemir/WorkItemManagement</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ported plusteam tests exercise internal members (e.g. ParseObjectiveNumber) exactly as
         they did before the move. Widening those members to public to make them testable would have
         changed the surface the move was supposed to preserve. -->
    <InternalsVisibleTo Include="WorkItemManagement.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DomainServices.Core" Version="0.3.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
