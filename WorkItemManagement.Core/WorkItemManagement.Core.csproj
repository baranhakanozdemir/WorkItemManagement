  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DomainServices.Core" Version="0.2.1" />
  </ItemGroup>

</Project>
