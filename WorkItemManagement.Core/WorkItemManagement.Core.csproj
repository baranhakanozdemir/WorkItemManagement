<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ship the XML docs. A consumer maps these entities onto its own DbContext and composes the
         services, so what a member means - which state transitions are legal, which fields the
         tenant and soft-delete filters depend on - has to travel with the assembly. Without this
         the package ships bare signatures and every such rule stays behind in this repo. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 is "this public member has no doc comment", which most of the work-item surface
         trips on. Documenting it is its own work, and gating the build on it now would only invite
         placeholder comments. What stays on is every warning that means a doc LIES - a broken cref,
         a malformed block, a missing param - because a wrong doc is worse than an absent one. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>WorkItemManagement.Core</PackageId>
    <Version>0.5.0</Version>
    <Authors>baranhakanozdemir</Authors>
    <Description>Canonical work-item domain model: entities, services, and repository interfaces. Extracted from PlusTeam.</Description>
    <RepositoryUrl>https://github.com/baranhakanozdemir/WorkItemManagement</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DomainServices.Core" Version="0.3.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
